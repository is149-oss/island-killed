<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Island.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки Island" Width="900" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource T.Bg}" Foreground="{StaticResource T.Text}" FontFamily="{DynamicResource T.Font}" FontSize="13" UseLayoutRounding="True" Icon="pack://application:,,,/Assets/island.ico" xmlns:island="clr-namespace:Island;assembly=Island" xmlns:branding="clr-namespace:Island">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Border Name="Frame" BorderBrush="{StaticResource T.Border}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Name="Sidebar" Background="{StaticResource T.Sidebar}">
        <Grid.RowDefinitions>
          <RowDefinition Height="70" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
          <Grid Width="34" Height="34" VerticalAlignment="Center">
            <UIElement.Clip>
              <RectangleGeometry Rect="0,0,34,34" RadiusX="9" RadiusY="9" />
            </UIElement.Clip>
            <Border CornerRadius="9" BorderBrush="#26FFFFFF" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#343A5C" Offset="0" />
                  <GradientStop Color="#181A26" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Path Data="M4,0 Q7.5,0 7.5,3.5 L7.5,6.5 Q7.5,11.5 12.5,11.5 L21.5,11.5 Q26.5,11.5 26.5,6.5 L26.5,3.5 Q26.5,0 30,0" Fill="#FF000000" />
            <Path Data="M7.5,6.5 Q7.5,11.5 12.5,11.5 L21.5,11.5 Q26.5,11.5 26.5,6.5" Stroke="#40FFFFFF" StrokeThickness="0.75" />
            <Ellipse Width="4" Height="4" Fill="{StaticResource T.Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,3.7,0,0" />
            <Border Width="7" Height="1.6" CornerRadius="0.8" Background="#B3FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,4.9,0,0" />
          </Grid>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel Name="TitleLine" Orientation="Horizontal">
              <TextBlock Text="Island" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="Настройки" FontSize="11" Foreground="{StaticResource T.Text3}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Name="Nav" Margin="12,4,12,12" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="12,0,12,14">
          <Border Height="1" Background="{StaticResource T.Divider}" Margin="8,0,8,10" />
          <Button Name="ProCard" Style="{StaticResource T.ProCard}" Click="ProCard_Click">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="ProIcon" Text="" FontFamily="{StaticResource T.Icons}" FontSize="14" Foreground="{StaticResource T.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static branding:DeveloperBranding.CardTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Name="ProStatus" FontSize="11" Foreground="{StaticResource T.Text2}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Button>
          <StackPanel Name="BottomNav" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
      <Grid Name="ContentArea" Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Name="StickyHost" Grid.Row="1" ZIndex="2" Margin="40,0,50,0" MaxWidth="700" Visibility="Collapsed" />
        <Border Name="StickyFade" Grid.Row="2" Margin="40,0,50,0" Height="26" Opacity="0" BorderBrush="{StaticResource T.Divider}" BorderThickness="0,1,0,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="{StaticResource C.Bg}" Offset="0" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button Style="{StaticResource T.CaptionButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть" Click="Minimize_Click" />
          <Button Name="MaxButton" Style="{StaticResource T.CaptionButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть" Click="Maximize_Click" />
          <Button Style="{StaticResource T.CloseButton}" Content="" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть" Click="Close_Click" />
        </StackPanel>
        <ScrollViewer Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Name="Body" Margin="40,0,40,36" MaxWidth="700">
            <UIElement.RenderTransform>
              <TranslateTransform x:Name="BodyShift" />
            </UIElement.RenderTransform>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
