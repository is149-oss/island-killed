                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="AiInput" Style="{StaticResource IslandTextBox}" Padding="8,8" MaxHeight="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" PreviewKeyDown="AiInput_PreviewKeyDown" TextChanged="AiInput_TextChanged" />
                    <TextBlock Name="AiPlaceholder" Text="Спросите что-нибудь…" Margin="12,0,0,0" FontSize="13" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button Name="AiSendButton" Grid.Column="1" Style="{StaticResource PinButton}" Width="30" Height="30" FontSize="12" Margin="0,0,3,0" VerticalAlignment="Bottom" ToolTip="Отправить" Click="AiSend_Click">
                      <TextBlock Name="AiSendIcon" Text="" />
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <Grid Name="PhonePanel" Height="266" VerticalAlignment="Top">
              <Grid Margin="14,0,14,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border HorizontalAlignment="Center" Background="{StaticResource Surface}" CornerRadius="11" Padding="2" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <Button Name="PhoneSubNotes" Style="{StaticResource SubTab}" Tag="0" Content="Уведомления" Click="PhoneSubTab_Click" />
                    <Button Name="PhoneSubFiles" Style="{StaticResource SubTab}" Tag="2" Content="Файлы" Click="PhoneSubTab_Click" />
                    <Button Name="PhoneSubDevice" Style="{StaticResource SubTab}" Tag="1" Content="Телефон" Click="PhoneSubTab_Click" />
                  </StackPanel>
                </Border>
                <Button Name="PhoneDndButton" Style="{StaticResource PinButton}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,0,0" Click="PhoneDnd_Click">
                  <TextBlock Name="PhoneDndIcon" Text="" FontFamily="{StaticResource Icons}" FontSize="12" />
                </Button>
                <Grid Row="1">
                  <Grid Name="PhoneNotesView">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Name="PhoneCenterHeader" Margin="2,0,2,6">
                      <TextBlock Name="PhoneCenterCount" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                      <Button Name="PhoneClearAll" Style="{StaticResource LinkButton}" Content="Очистить все" HorizontalAlignment="Right" Click="PhoneClearAll_Click" />
                    </Grid>
                    <ScrollViewer Name="PhoneCenterScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                      <StackPanel Name="PhoneCenterList" />
                    </ScrollViewer>
                    <StackPanel Name="PhoneCenterEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                      <TextBlock Text="" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" />
                      <TextBlock Name="PhoneCenterEmptyText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                      <Button Name="PhoneCenterSetup" Style="{StaticResource ToastActionButton}" Content="Настройки телефона" Margin="0,10,0,0" HorizontalAlignment="Center" Click="PhoneSetup_Click" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Name="PhoneDeviceView" Visibility="Collapsed" Margin="0,2,0,0" />
                  <Grid Name="PhoneFilesView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6" Height="40">
                      <Rectangle Name="PhoneDropFrame" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="4 3" Stroke="#33FFFFFF" Fill="#0AFFFFFF" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="PhoneDropIcon" Text="" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Name="PhoneDropText" Text="Перетащите файлы сюда — они уйдут на телефон" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>
                    <ScrollViewer Name="PhoneFilesScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                      <StackPanel Name="PhoneFilesList" />
                    </ScrollViewer>
                    <TextBlock Name="PhoneFilesEmpty" Grid.Row="1" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,20" Text="Здесь будут файлы и фото, которые пришли с телефона или ушли на него. С телефона — «Поделиться → На компьютер»" />
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
            <Grid Name="MonitorPanel" Height="216" VerticalAlignment="Top">
              <Grid Margin="16,2,16,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="3,0,3,7">
                  <TextBlock Name="MonitorTitle" Text="Мониторинг" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#00FFFFFF" ToolTip="Когда игра идёт на весь экран, остров показывает нагрузку вместо обычного вида (часов, погоды). Снимите галочку, и остров будет вести себя как обычно">
                    <TextBlock Text="Мониторинг в игре" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <CheckBox Name="GameModeCheck" Style="{StaticResource IslandSwitch}" Click="GameModeCheck_Click" />
                  </StackPanel>
                </Grid>
                <UniformGrid Name="MonitorGrid" Grid.Row="1" Columns="2" Rows="3" />
              </Grid>
            </Grid>
            <Grid Name="UpdatePanel" Height="170" VerticalAlignment="Top">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,10">
                <Border Width="40" Height="40" CornerRadius="20" Background="#265ED87A" HorizontalAlignment="Center">
                  <TextBlock Text="" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="#5ED87A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Эта версия Island устарела" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Name="UpdatePanelText" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Text="Чтобы пользоваться островом дальше, установите новую — это займёт минуту, настройки сохранятся" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                  <Button Style="{StaticResource ToastActionButton}" FontSize="12" Content="Обновить" Click="UpdateNow_Click" />
                  <Button Style="{StaticResource LinkButton}" Content="Страница релиза" Margin="10,0,0,0" VerticalAlignment="Center" Click="UpdatePage_Click" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid Name="ProPanel" Height="160" VerticalAlignment="Top">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,10">
                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Surface}" HorizontalAlignment="Center">
                  <TextBlock Text="" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Name="ProTitle" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static local:DeveloperBranding.LockedDescription}" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                  <Button Style="{StaticResource ToastActionButton}" FontSize="12" Content="Ввести ключ" Click="ProKey_Click" />
                  <Button Name="ProBuyButton" Style="{StaticResource LinkButton}" Content="Купить в Telegram" Margin="10,0,0,0" VerticalAlignment="Center" Click="ProBuy_Click" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
          <Border Name="TipBar" VerticalAlignment="Top" Margin="14,0,14,0" MinHeight="36" CornerRadius="12" Background="{StaticResource Surface}" Visibility="Collapsed" Opacity="0">
            <Grid Margin="10,6,6,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <TextBlock Name="TipText" Grid.Column="1" Margin="8,0" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Понятно" FontSize="11" VerticalAlignment="Center" Click="TipClose_Click" />
            </Grid>
          </Border>
        </Grid>
        <Grid Name="ToastPanel" Width="318" Height="38" Opacity="0" IsHitTestVisible="False" Background="#00FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" MouseWheel="Toast_MouseWheel">
          <Grid Name="ToastRow" Margin="13,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Name="ToastIconHost" Width="26" Height="26" Background="#00FFFFFF" VerticalAlignment="Center" PreviewMouseLeftButtonDown="ToastIcon_MouseDown" MouseMove="ToastIcon_MouseMove">
              <Ellipse Name="ToastRing" StrokeThickness="1.5" Stroke="#5ED87A" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="ToastRingScale" />
                </UIElement.RenderTransform>
              </Ellipse>
              <Ellipse Name="ToastRing2" StrokeThickness="1.5" Stroke="#5ED87A" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="ToastRing2Scale" />
                </UIElement.RenderTransform>
              </Ellipse>
              <TextBlock Name="ToastIconGhost" FontFamily="{StaticResource Icons}" FontSize="15" Opacity="0" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="ToastGhostShift" />
                </UIElement.RenderTransform>
              </TextBlock>
              <TextBlock Name="ToastIcon" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Name="ToastThumb" CornerRadius="6" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush x:Name="ToastThumbBrush" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <Grid Name="ToastCheck" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="ToastCheckScale" />
                </UIElement.RenderTransform>
                <Ellipse Fill="#5ED87A" />
                <Path Name="ToastCheckPath" Data="M7.5,13.5 L11.2,17 L18.5,9.5" Stroke="#FF000000" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="8 8" StrokeDashOffset="8" />
              </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
              <TextBlock Name="ToastLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis">
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="ToastLabelShift" />
                </UIElement.RenderTransform>
              </TextBlock>
              <TextBlock Name="ToastSub" FontSize="11" Margin="0,1,0,0" Visibility="Collapsed" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Name="ToastBar" Column="2" Width="104" Height="14" VerticalAlignment="Center" Background="#00FFFFFF" MouseLeftButtonDown="ToastBar_MouseDown" MouseMove="ToastBar_MouseMove" MouseLeftButtonUp="ToastBar_MouseUp">
              <Border Background="{StaticResource Track}" CornerRadius="2.5" Height="5" />
              <Border Name="ToastFill" Background="#FFFFFFFF" CornerRadius="2.5" Height="5" Width="0" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock Name="ToastValue" Grid.Column="3" MinWidth="34" Margin="8,0,0,0" FontSize="12" TextAlignment="Right" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
            <Button Name="ToastAction2" Grid.Column="4" Style="{StaticResource ToastGhostButton}" Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" Click="ToastAction2_Click" />
            <Button Name="ToastAction" Grid.Column="5" Style="{StaticResource ToastActionButton}" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" Click="ToastAction_Click" />
          </Grid>
          <Grid Name="PhoneCard" Visibility="Collapsed" Margin="14,11,14,11" VerticalAlignment="Top" Background="#00FFFFFF" Cursor="Hand" MouseLeftButtonUp="PhoneCard_Click">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Name="PhoneAvatar" Width="40" Height="40" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform />
              </UIElement.RenderTransform>
              <Ellipse Name="PhoneAvatarRound">
                <Shape.Fill>
                  <ImageBrush x:Name="PhoneAvatarBrush" Stretch="UniformToFill" />
                </Shape.Fill>
              </Ellipse>
              <Border Name="PhoneAvatarSquare" CornerRadius="10" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush x:Name="PhoneAppBrush" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <Grid Name="PhoneAvatarGlyph" Visibility="Collapsed">
                <Ellipse Fill="#2C2C2E" />
                <TextBlock Name="PhoneGlyph" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <Border Name="PhoneBadge" Width="16" Height="16" CornerRadius="5" Margin="0,0,-3,-3" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#FF000000" BorderThickness="1.5" RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Background>
                  <ImageBrush x:Name="PhoneBadgeBrush" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Grid>
            <StackPanel Name="PhoneWords" Grid.Column="1" Margin="12,1,0,0">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="PhoneLinesShift" />
              </UIElement.RenderTransform>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="PhoneTitle" FontSize="13.5" TextTrimming="CharacterEllipsis">
                  <Run Name="PhoneWho" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                  <Run Name="PhoneApp" Foreground="{StaticResource TextTertiary}" />
                </TextBlock>
                <TextBlock Name="PhoneTime" Grid.Column="1" FontSize="11" Margin="10,1,0,0" Foreground="{StaticResource TextTertiary}" />
              </Grid>
              <TextBlock Name="PhoneText" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="35.5" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
            <StackPanel Name="PhoneMore" Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" Visibility="Collapsed" Cursor="Arrow">
              <ScrollViewer Name="PhoneHistoryScroll" MaxHeight="210" VerticalScrollBarVisibility="Hidden" Focusable="False">
                <StackPanel Name="PhoneHistory" />
              </ScrollViewer>
              <Border Name="PhoneReplyFrame" Background="{StaticResource Surface}" CornerRadius="14" MinHeight="34" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#00FFFFFF">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Name="PhoneReplyInput" Style="{StaticResource IslandTextBox}" Padding="8,7" MaxHeight="84" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" PreviewKeyDown="PhoneReplyInput_PreviewKeyDown" TextChanged="PhoneReplyInput_TextChanged" />
                  <TextBlock Name="PhoneReplyPlaceholder" Text="Ответить…" Margin="12,0,0,0" FontSize="13" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Button Name="PhoneReplySend" Grid.Column="1" Style="{StaticResource PinButton}" Width="28" Height="28" FontSize="12" Margin="0,0,3,2" VerticalAlignment="Bottom" ToolTip="Отправить" Click="PhoneReplySend_Click">
                    <TextBlock Text="" />
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel Name="PhoneButtons" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
              <Button Name="PhoneButton2" Style="{StaticResource ToastGhostButton}" Click="PhoneButton_Click" />
              <Button Name="PhoneButton1" Style="{StaticResource ToastActionButton}" Margin="6,0,0,0" Click="PhoneButton_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
