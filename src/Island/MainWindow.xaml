<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Island.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Island" Title="Island" Width="460" Height="372" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True" FontFamily="{DynamicResource T.Font}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <FontFamily x:Key="Symbols">Segoe UI Symbol</FontFamily>
      <SolidColorBrush x:Key="TextPrimary" Color="#F5FFFFFF" />
      <SolidColorBrush x:Key="TextSecondary" Color="#A6FFFFFF" />
      <SolidColorBrush x:Key="TextTertiary" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="Track" Color="#2EFFFFFF" />
      <SolidColorBrush x:Key="Surface" Color="#12FFFFFF" />
      <Storyboard x:Key="PressIn">
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.09" />
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.09" />
      </Storyboard>
      <Storyboard x:Key="PressOut">
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.38">
          <DoubleAnimation.EasingFunction>
            <BackEase Amplitude="0.6" EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.38">
          <DoubleAnimation.EasingFunction>
            <BackEase Amplitude="0.6" EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
      </Storyboard>
      <Style x:Key="IconButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#00FFFFFF" CornerRadius="22" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#1FFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#38FFFFFF" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SurfaceButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" CornerRadius="20" Background="{StaticResource Surface}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#26FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#3DFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#F0FFFFFF" CornerRadius="23" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#CCFFFFFF" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TabButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <Border Background="{TemplateBinding Control.Background}" CornerRadius="14" />
                <Border Name="Hover" Background="#10FFFFFF" CornerRadius="14" Opacity="0" />
                <ContentPresenter Margin="7,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Hover" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RowButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#00FFFFFF" CornerRadius="10" Padding="6,0">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#16FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#28FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PinButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#00FFFFFF" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#1FFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#33FFFFFF" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LinkButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="#00FFFFFF" Padding="6,4">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FmtButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <Border Background="{TemplateBinding Control.Background}" CornerRadius="8" />
                <Border Name="Hover" Background="#1AFFFFFF" CornerRadius="8" Opacity="0" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Hover" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SubTab" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="9" Padding="12,3">
                <ContentPresenter HorizontalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CalSeg" TargetType="{x:Type Button}" BasedOn="{StaticResource SubTab}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="8" Padding="8,3">
                <ContentPresenter HorizontalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RoundCheck" TargetType="{x:Type CheckBox}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Width="18" Height="18" Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <Ellipse Name="Ring" Stroke="#66FFFFFF" StrokeThickness="1.5" />
                <Ellipse Name="Fill" Fill="#5ED87A" Opacity="0" />
                <Path Name="Tick" Data="M4.5,9.5 L7.8,12.5 L13.5,6" Stroke="#FF000000" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Fill" Property="UIElement.Opacity" Value="1" />
                  <Setter TargetName="Tick" Property="UIElement.Opacity" Value="1" />
                  <Setter TargetName="Ring" Property="UIElement.Opacity" Value="0" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.EnterActions>
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Ring" Property="Shape.Stroke" Value="#B3FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="IslandSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Width="32" Height="18" Background="#00FFFFFF">
                <Border Name="Track" CornerRadius="9" Background="#3A3A41" />
                <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0">
                  <UIElement.RenderTransform>
                    <TranslateTransform x:Name="Knob" />
                  </UIElement.RenderTransform>
                </Ellipse>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Border.Background" Value="#7B8CFF" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="14" Duration="0:0:0.22">
                          <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                          <DoubleAnimation.EasingFunction>
                            <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                          </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.ExitActions>
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Track" Property="UIElement.Opacity" Value="0.88" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="IslandTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextBoxBase.CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="TextBoxBase.SelectionBrush" Value="#8BE9A8" />
        <Setter Property="FontSize" Value="13" />
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TypingBox_PreviewMouseLeftButtonDown" />
        <EventSetter Event="PreviewKeyDown" Handler="TypingBox_PreviewKeyDown" />
      </Style>
      <Style x:Key="ToastActionButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#F0FFFFFF" CornerRadius="11" Padding="11,3" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#FFFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ToastGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ToastActionButton}">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" Background="#26FFFFFF" CornerRadius="11" Padding="10,3" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <ScaleTransform x:Name="Press" />
                </UIElement.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#40FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PressIn}" />
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource PressOut}" />
                  </TriggerBase.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="EqBar" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Rectangle.RadiusX" Value="1.5" />
        <Setter Property="Rectangle.RadiusY" Value="1.5" />
        <Setter Property="Margin" Value="1.5,0" />
        <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Root">
    <local:LiquidShape x:Name="Shape" />
    <Grid Name="Bubble" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Background="#01000000" Cursor="Hand" Opacity="0" MouseLeftButtonUp="Bubble_Click" MouseEnter="Bubble_MouseEnter">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="BubbleShift" />
      </UIElement.RenderTransform>
      <Grid Name="BubbleInner" RenderTransformOrigin="0.5,0.5">
        <UIElement.RenderTransform>
          <ScaleTransform />
        </UIElement.RenderTransform>
        <Ellipse Name="BubbleWave" Width="24" Height="24" StrokeThickness="1.5" Stroke="#5ED87A" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="BubbleWaveScale" />
          </UIElement.RenderTransform>
        </Ellipse>
        <Grid Name="BubbleDownload" Width="24" Height="24">
          <Ellipse Fill="#1F5ED87A" />
          <Path Name="BubbleSpinner" Stroke="#5ED87A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1 A11,11 0 0 1 23,12" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <RotateTransform x:Name="BubbleSpin" />
            </UIElement.RenderTransform>
          </Path>
          <TextBlock Text="" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#5ED87A" HorizontalAlignment="Center" VerticalAlignment="Center">
            <UIElement.RenderTransform>
              <TranslateTransform x:Name="BubbleArrowShift" />
            </UIElement.RenderTransform>
          </TextBlock>
        </Grid>
        <Grid Name="BubblePhone" Width="24" Height="24">
          <Ellipse Name="BubbleAvatarRound">
            <Shape.Fill>
              <ImageBrush x:Name="BubbleAvatarBrush" Stretch="UniformToFill" />
            </Shape.Fill>
          </Ellipse>
          <Border Name="BubbleAvatarSquare" CornerRadius="6">
            <Border.Background>
              <ImageBrush x:Name="BubbleAppBrush" Stretch="UniformToFill" />
            </Border.Background>
          </Border>
          <Border Name="BubbleCount" Height="13" MinWidth="13" CornerRadius="6.5" Background="#E5484D" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-3">
            <TextBlock Name="BubbleCountText" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Name="Pill" Background="#00FFFFFF" Width="220" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" AllowDrop="True" MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" PreviewMouseLeftButtonDown="Pill_PreviewMouseLeftButtonDown" DragEnter="Pill_DragEnter" DragOver="Pill_DragOver" DragLeave="Pill_DragLeave" Drop="Pill_Drop">
      <Grid Name="PillContent">
        <Grid Name="IdlePanel" Width="250" Height="32" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Name="IdleClock" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <Border Name="LangBadge" Margin="7,1,0,0" Height="15" CornerRadius="5" Background="#24FFFFFF" Padding="4,0" VerticalAlignment="Center" ToolTip="Раскладка клавиатуры">
              <TextBlock Name="LangText" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="11" />
            </Border>
            <TextBlock Name="CapsIcon" Text="⇪" FontFamily="{StaticResource Symbols}" FontSize="12" Margin="5,0,0,0" Foreground="#FFD25A" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Caps Lock включён" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
            <StackPanel Name="IdleWeather" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
              <TextBlock Name="IdleWeatherIcon" FontFamily="{StaticResource Symbols}" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Name="IdleWeatherText" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="IdleRightIcon" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            <TextBlock Name="IdleRightText" FontSize="12" Margin="5,0,0,0" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid Name="CompactPanel" Width="298" Height="32" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Grid Name="CompactCover" Width="22" Height="22" HorizontalAlignment="Left" Margin="6,0,0,0">
            <Border Background="#2A2A2A" CornerRadius="6" />
            <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background>
                <ImageBrush x:Name="CompactCoverBrush" Stretch="UniformToFill" />
              </Border.Background>
