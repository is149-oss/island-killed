<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="C.Bg">#151517</Color>
  <Color x:Key="C.Sidebar">#1B1B1E</Color>
  <Color x:Key="C.Card">#222226</Color>
  <Color x:Key="C.Field">#2B2B30</Color>
  <Color x:Key="C.Divider">#2F2F35</Color>
  <Color x:Key="C.Accent">#7B8CFF</Color>
  <SolidColorBrush x:Key="T.Bg" Color="{StaticResource C.Bg}" />
  <SolidColorBrush x:Key="T.Sidebar" Color="{StaticResource C.Sidebar}" />
  <SolidColorBrush x:Key="T.Card" Color="{StaticResource C.Card}" />
  <SolidColorBrush x:Key="T.CardHover" Color="#28282D" />
  <SolidColorBrush x:Key="T.Field" Color="{StaticResource C.Field}" />
  <SolidColorBrush x:Key="T.FieldHover" Color="#323238" />
  <SolidColorBrush x:Key="T.Divider" Color="{StaticResource C.Divider}" />
  <SolidColorBrush x:Key="T.Border" Color="#2C2C33" />
  <SolidColorBrush x:Key="T.Text" Color="#F2F2F5" />
  <SolidColorBrush x:Key="T.Text2" Color="#A1A1AA" />
  <SolidColorBrush x:Key="T.Text3" Color="#6E6E78" />
  <SolidColorBrush x:Key="T.Accent" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="T.AccentSoft" Color="#267B8CFF" />
  <SolidColorBrush x:Key="T.Danger" Color="#FF6B6B" />
  <FontFamily x:Key="T.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="T.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <Style x:Key="T.CaptionButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource T.Text2}" />
    <Setter Property="FontFamily" Value="{StaticResource T.Icons}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bg" Background="#00FFFFFF">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="#1FFFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource T.CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bg" Background="#00FFFFFF">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="#E5484D" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Button" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="Background" Value="{StaticResource T.Field}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bg" Background="{TemplateBinding Control.Background}" CornerRadius="9" Padding="{TemplateBinding Control.Padding}" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </UIElement.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="UIElement.Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.25">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.25">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource T.Button}">
    <Setter Property="Background" Value="{StaticResource T.Accent}" />
    <Setter Property="Foreground" Value="#0E0E12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="T.GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource T.Button}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource T.Text2}" />
  </Style>
  <Style x:Key="T.TextBox" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="Background" Value="{StaticResource T.Field}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource T.Text}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{StaticResource T.Accent}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Bg" Background="{TemplateBinding Control.Background}" CornerRadius="9" BorderThickness="1.5" BorderBrush="#00FFFFFF">
            <Grid>
              <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
              <TextBlock Name="Hint" Text="{TemplateBinding FrameworkElement.Tag}" Margin="{TemplateBinding Control.Padding}" Padding="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Foreground="{StaticResource T.Text3}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="{StaticResource T.FieldHover}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="Border.BorderBrush" Value="{StaticResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Switch" TargetType="{x:Type CheckBox}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="42" Height="24" Background="#00FFFFFF">
            <Border Name="Track" CornerRadius="12" Background="#3A3A41" BorderThickness="0" />
            <Ellipse Width="18" Height="18" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="Knob" />
              </UIElement.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Track" Property="Border.Background" Value="{StaticResource T.Accent}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="Border.BorderBrush" Value="#99FFFFFF" />
              <Setter TargetName="Track" Property="Border.BorderThickness" Value="1.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.SliderFill" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource T.Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.SliderRest" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.SliderThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Width="18" Height="18" Background="#00FFFFFF">
            <Ellipse Name="Halo" Margin="-4" Opacity="0" Fill="{StaticResource T.AccentSoft}" />
            <Ellipse Fill="#FFFFFFFF" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="Halo" Property="UIElement.Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Slider" TargetType="{x:Type Slider}">
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Height="26" Background="#00FFFFFF">
            <Border Height="4" CornerRadius="2" Background="#3A3A41" VerticalAlignment="Center" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource T.SliderFill}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource T.SliderRest}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource T.SliderThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Segment" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource T.Text2}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Bg" Background="#00FFFFFF" CornerRadius="7" Padding="12,5">
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="#3B3B44" />
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource T.Text2}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </UIElement.RenderTransform>
            <Border Name="Hover" Background="#14FFFFFF" CornerRadius="8" Opacity="0" />
            <Border Name="Selected" Background="#1FFFFFFF" CornerRadius="8" Opacity="0" />
            <Border Padding="12,8">
              <ContentPresenter>
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="Lean" />
                </UIElement.RenderTransform>
              </ContentPresenter>
            </Border>
            <Border Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Background="{StaticResource T.Accent}">
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="BarScale" ScaleY="0" />
              </UIElement.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Lean" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                    <DoubleAnimation Storyboard.TargetName="Lean" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.35">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.ProCard" TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bg" CornerRadius="10" Padding="12,9" BorderThickness="1" BorderBrush="#00FFFFFF" RenderTransformOrigin="0.5,0.5" Background="{StaticResource T.AccentSoft}">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </UIElement.RenderTransform>
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.BorderBrush" Value="{StaticResource T.Accent}" />
            </Trigger>
            <Trigger Property="FrameworkElement.Tag" Value="on">
              <Setter TargetName="Bg" Property="Border.BorderBrush" Value="{StaticResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Chip" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource T.Text2}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Bg" CornerRadius="14" Padding="11,5" BorderThickness="1" BorderBrush="#00FFFFFF" RenderTransformOrigin="0.5,0.5" Background="{StaticResource T.Field}">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </UIElement.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="{StaticResource T.FieldHover}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="{StaticResource T.AccentSoft}" />
              <Setter TargetName="Bg" Property="Border.BorderBrush" Value="{StaticResource T.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource T.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.08" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.08" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.35">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.8" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.35">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.8" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="T.VScroll" TargetType="{x:Type ScrollBar}">
    <Track Name="PART_Track" IsDirectionReversed="True" Width="8">
      <Track.Thumb>
        <Thumb>
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border CornerRadius="3" Background="#3DFFFFFF" Margin="2,2" />
            </ControlTemplate>
          </Control.Template>
        </Thumb>
      </Track.Thumb>
    </Track>
  </ControlTemplate>
  <ControlTemplate x:Key="T.HScroll" TargetType="{x:Type ScrollBar}">
    <Track Name="PART_Track" Height="8">
      <Track.Thumb>
        <Thumb>
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border CornerRadius="3" Background="#3DFFFFFF" Margin="2,2" />
            </ControlTemplate>
          </Control.Template>
        </Thumb>
      </Track.Thumb>
    </Track>
  </ControlTemplate>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Template" Value="{StaticResource T.VScroll}" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template" Value="{StaticResource T.HScroll}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource T.Font}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="ContextMenu.HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="#232327" BorderBrush="#34343B" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,8,8">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black" />
            </UIElement.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border Name="Bg" Background="#00FFFFFF" CornerRadius="6" Padding="12,7" MinWidth="170">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="#2E2E35" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource T.Text3}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Foreground" Value="{StaticResource T.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource T.Font}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="#26262B" BorderBrush="#34343B" BorderThickness="1" CornerRadius="7" Padding="9,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>